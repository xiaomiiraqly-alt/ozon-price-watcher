# Secrets are asked interactively by ./install.sh; never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_PROXY_URL=socks5://awg-client:1080
CHECK_INTERVAL_SECONDS=1800
PRICE_MODE=bank
OZON_GATEWAY_URL=http://ozon-gateway:8085
GATEWAY_TOKEN=
DATABASE_PATH=/data/watcher.sqlite3
# For family login, set an HTTPS hostname, e.g. ozon.your-domain.tld.
# If empty, the bot's /connect explains that self-service login is disabled.
LOGIN_DOMAIN=
LOGIN_BASE_URL=
